{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2023",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* jszip's own shipped .d.ts unconditionally does `/// <reference types="node" />`,
       which leaks Node's ambient setTimeout/Timeout globals into this browser-only
       project (confirmed conflict, not theoretical — breaks window.setTimeout typing
       app-wide). Type-check against a local stub instead; Vite's runtime bundling is
       unaffected since `paths` only changes TypeScript's type resolution. */
    "baseUrl": ".",
    "paths": {
      "jszip": ["./src/types/jszip-stub.d.ts"]
    },

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"],
  /* Everything else that used to sit here pointed at orphaned files, now deleted.
     Only genuinely non-app sources stay excluded. */
  "exclude": [
    "src/test/**/*"
  ]
}
