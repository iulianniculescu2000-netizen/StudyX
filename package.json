{
  "name": "studyx",
  "productName": "StudyX",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Aplicatie de grile pentru studenti la medicina",
  "engines": {
    "node": ">=22.13.0"
  },
  "author": "StudyX",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "type-check": "tsc -b",
    "lint": "eslint .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:smoke": "vitest run src/test/smoke/app-boot.test.ts src/test/smoke/diagnostics.test.ts src/test/smoke/storage.test.ts",
    "security:scan": "node scripts/scan-secrets.cjs",
    "verify:runtime": "node scripts/verify-runtime.cjs",
    "release:guard": "node scripts/release-guard.cjs",
    "verify:all": "npm.cmd run security:scan && npm.cmd run lint && npm.cmd run build && npm.cmd run test:run && npm.cmd run verify:runtime",
    "preview": "vite preview",
    "dist": "npm.cmd run electron:build",
    "generate-icon": "node scripts/generate-premium-assets.cjs",
    "prepare-update": "npm.cmd run build && node scripts/prepare-update.cjs",
    "publish-update": "node scripts/publish-update.cjs",
    "updates:sync-local": "node scripts/sync-updates-local.cjs",
    "electron:dev": "cross-env.cmd NODE_ENV=development concurrently.cmd \"vite.cmd\" \"wait-on.cmd http://localhost:5173 && electron.cmd .\"",
    "electron:build": "node scripts/patch-nsis-ro.cjs && npm.cmd run generate-icon && npm.cmd run build && electron-builder.cmd",
    "electron:build:dir": "npm.cmd run generate-icon && npm.cmd run build && electron-builder.cmd --dir",
    "electron:publish": "node scripts/publish-release.cjs",
    "analyze": "node scripts/analyze-bundle.js",
    "analyze:build": "npm.cmd run build && npm.cmd run analyze",
    "bundle-report": "webpack-bundle-analyzer dist/static/js/*.js",
    "optimize-images": "node scripts/optimize-images.js",
    "optimize-images:responsive": "node scripts/optimize-images.js --responsive",
    "dev:npx": "node scripts/dev-commands.js dev",
    "build:npx": "node scripts/dev-commands.js build",
    "test:npx": "node scripts/dev-commands.js test",
    "analyze:npx": "node scripts/dev-commands.js analyze",
    "electron:dev:npx": "node scripts/dev-commands.js electron:dev",
    "lighthouse:npx": "node scripts/dev-commands.js lighthouse",
    "ai:test:npx": "node scripts/dev-commands.js ai:test",
    "install-deps": "node scripts/dev-commands.js install-deps"
  },
  "build": {
    "appId": "com.studyx.app",
    "productName": "StudyX",
    "executableName": "StudyX",
    "afterPack": "scripts/after-pack-win.cjs",
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "node_modules/@napi-rs/**/*",
      "node_modules/pdf-parse/**/*",
      "node_modules/pdfjs-dist/**/*",
      "node_modules/tesseract.js/**/*",
      "public/icon.ico",
      "public/icon.png"
    ],
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico",
      "forceCodeSigning": false,
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StudyX",
      "artifactName": "StudyX-Setup-${version}.${ext}",
      "menuCategory": "StudyX",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeaderIcon": "public/icon.ico",
      "installerSidebar": "build/sidebar.bmp",
      "uninstallerSidebar": "build/sidebar.bmp",
      "installerHeader": "build/header.bmp",
      "language": "1048",
      "installerLanguages": [
        "ro_RO"
      ],
      "license": "LICENSE.txt",
      "runAfterFinish": true,
      "uninstallDisplayName": "StudyX",
      "warningsAsErrors": false
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/icon.ico",
      "public/icon.png",
      "public/icon.svg",
      "package.json",
      "!**/*.map",
      "!**/*.ts",
      "!**/*.tsx",
      "!**/.git/**",
      "!**/.claude/**",
      "!studyx-releases{,/**}",
      "!studyx-releases-temp{,/**}",
      "!release{,/**}",
      "!Chestii utile{,/**}",
      "!Grile{,/**}",
      "!SABLON{,/**}",
      "!*.docx",
      "!*.png",
      "!.env*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "iulianniculescu2000-netizen",
        "repo": "studyx-releases",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "build/books",
        "to": "books",
        "filter": [
          "**/*.pdf"
        ]
      }
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-virtual": "^3.14.16",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "dompurify": "^3.4.16",
    "electron-updater": "^6.8.3",
    "framer-motion": "^14.0.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "katex": "^0.19.0",
    "lucide-react": "^1.49.0",
    "mammoth": "^1.12.0",
    "mermaid": "^12.1.0",
    "minisearch": "^7.2.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.8.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sql.js": "^1.14.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "axe-core": "^4.14.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.8.1",
    "electron-winstaller": "^5.4.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^30.1.2",
    "rcedit": "^5.0.2",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wait-on": "^9.0.4"
  },
  "allowScripts": {
    "electron@44.5.1": true,
    "electron-winstaller@5.4.0": true,
    "electron-winstaller@5.4.4": true,
    "core-js@3.50.0": true,
    "tesseract.js@7.0.0": true
  }
}
